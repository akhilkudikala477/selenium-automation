<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="2">
	<listeners>
		<listener class-name="com.jalaAcademy.utils.Listeners"></listener>
	</listeners>
	<test name="Chrome test">
		<parameter name="browser" value="chrome"></parameter>
		<parameter name="siteURL"
			value="https://magnus.jalatechnologies.com/Account/Login"></parameter>
		<classes>
			<class name="com.jalaAcademy.automation.LoginTest" />
			<class name="com.jalaAcademy.automation.EmployeeDetailsTest" />
			<class name="com.jalaAcademy.automation.SearchEmployeeTest" />
			<class name="com.jalaAcademy.automation.MenuTest" />
			<class name="com.jalaAcademy.automation.IframeTest" />
			<class name="com.jalaAcademy.automation.ImagesTest" />
		</classes>
	</test>
	<test name="Firefox">
		<parameter name="browser" value="firefox"></parameter>
		<parameter name="siteURL"
			value="https://magnus.jalatechnologies.com/Account/Login"/>
		<classes>
			<class name="com.jalaAcademy.automation.LoginTest" />
			<class name="com.jalaAcademy.automation.EmployeeDetailsTest" />
			<class name="com.jalaAcademy.automation.SearchEmployeeTest" />
			<class name="com.jalaAcademy.automation.MenuTest" />
			<class name="com.jalaAcademy.automation.IframeTest" />
			<class name="com.jalaAcademy.automation.ImagesTest" />
		</classes>
	</test>
</suite> 
